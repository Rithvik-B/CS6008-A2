# Build artifacts (grader regenerates from source)
*.o
*.obj
interceptor
attacker
zonewalk
*.bin

# DNSSEC generated material (regenerated by signing scripts)
*.signed
*.signed.jnl
K*.key
K*.private
dsset-*
keyset-*
*.jbk
*.jnl
managed-keys.bind*

# PKI generated material (regenerated by pki scripts)
*.pem
*.crt
*.key.pem
*.csr
*.srl
ca/

# Capture / log evidence is committed selectively; ignore raw bulk
evidence/raw/
*.pcap.tmp

# OS / editor
.DS_Store
*~

# LaTeX build artifacts (report.pdf at repo root is the committed deliverable)
report/*.aux
report/*.log
report/*.out
report/*.toc
report/report.pdf
CS6008_AS2_DNS_Security.pdf

# DNSSEC generated (regenerated by sign/sign-all.sh)
trust-anchor.conf
build/
keys/

# PKI generated material (regenerated by pki/make-ca.sh) -- name-based so they
# match at any depth (slash-anchored patterns only match the repo root).
resolver.key
ca.key
ext.cnf
*.csr
*.srl
**/pki/out/
